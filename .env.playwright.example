# QRRest Playwright smoke-test environment.
# Default mode is read-only. Mutation/order creation is disabled unless explicitly enabled.

# Target host
PLAYWRIGHT_BASE_URL=https://test.qrrest-menu.ru

# Optional browser mode
PLAYWRIGHT_HEADED=0

# Strict mode converts missing baseline data/credentials from skips into clear failures.
QRREST_E2E_STRICT=0

# Optional baseline provisioner settings. Keep secrets out of the repository.
QRREST_E2E_BASELINE_APPLY=0
QRREST_E2E_RESTAURANT_SUBDOMAIN=test
QRREST_E2E_RESTAURANT_NAME=QRRest E2E Smoke Restaurant
QRREST_E2E_PASSWORD=
QRREST_E2E_RESET_PASSWORDS=1
QRREST_E2E_BASELINE_KDS_ORDER=1

# Read-only/order tracking fixtures
QRREST_E2E_TABLE_ID=
QRREST_E2E_ORDER_ID=
QRREST_E2E_TRACK_TOKEN=

# Mutating smoke checks. Keep disabled in production unless using a disposable test tenant.
QRREST_E2E_MUTATION=0
QRREST_E2E_CREATE_ORDER=0
QRREST_E2E_GUEST_NAME=Playwright Smoke Guest
QRREST_E2E_GUEST_PHONE=+79000000000
QRREST_E2E_DELIVERY_ADDRESS=Тестовый адрес Playwright, 1
QRREST_E2E_COMMENT=Playwright smoke validation

# Role credentials. Use dedicated test accounts only.
QRREST_OWNER_EMAIL=
QRREST_OWNER_PASSWORD=
QRREST_ADMIN_EMAIL=
QRREST_ADMIN_PASSWORD=
QRREST_STAFF_EMAIL=
QRREST_STAFF_PASSWORD=
QRREST_WAITER_EMAIL=
QRREST_WAITER_PASSWORD=
QRREST_KITCHEN_EMAIL=
QRREST_KITCHEN_PASSWORD=
QRREST_COLD_EMAIL=
QRREST_COLD_PASSWORD=
QRREST_BAR_EMAIL=
QRREST_BAR_PASSWORD=
QRREST_DESSERT_EMAIL=
QRREST_DESSERT_PASSWORD=
