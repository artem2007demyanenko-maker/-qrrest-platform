# Production env. Copy to .env.production and fill values.
# docker compose -f docker-compose.prod.yml --env-file .env.production up -d

APP_ENV=production
APP_URL=https://qrrest-menu.ru
APP_PROTOCOL=https
APP_MAIN_DOMAIN=qrrest-menu.ru
APP_COOKIE_DOMAIN=.qrrest-menu.ru
# HSTS из PHP: 0 = выключить; 1 = только max-age (без поддоменов по умолчанию)
APP_HSTS=1
# Только после wildcard TLS на *.MAIN_DOMAIN — иначе браузер застрянет на HTTPS для поддоменов без сертификата
APP_HSTS_INCLUDE_SUBDOMAINS=0
# Подключать только осознанно (preload-сайты)
APP_HSTS_PRELOAD=0
APP_DEBUG=0
# OTP_TEST_MODE=1 — только для dev/staging: код в логах и в JSON send_otp; в production оставьте 0 или не задавайте
# OTP_TEST_MODE=0

DB_HOST=db
DB_PORT=3306
DB_NAME=qr_rest
DB_USER=qr
DB_PASS=change_me
DB_ROOT_PASSWORD=rootpass

STRIPE_ENABLED=1
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASIC=
STRIPE_PRICE_ID_PRO=
STRIPE_SUCCESS_URL=https://qrrest-menu.ru/restaurant/dashboard.php
STRIPE_CANCEL_URL=https://qrrest-menu.ru/restaurant/activate.php

APP_VERSION=
GIT_SHA=

REDIS_HOST=
REDIS_PORT=6379
