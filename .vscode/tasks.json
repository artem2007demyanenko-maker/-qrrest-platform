{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Deploy: dry run",
      "type": "shell",
      "command": "./deploy.sh --dry-run",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Deploy: full",
      "type": "shell",
      "command": "./deploy.sh --full",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
